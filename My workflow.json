    {
      "parameters": {
        "jsCode": "const output = $input.item.json.output || '';\n\nconst lines = output.match(/\\d+\\.\\s+[^\\n]+TL[^\\n]*/g) || [];\n\nconst products = lines.slice(0, 5).map(line => {\n  const priceMatch = line.match(/([\\d,\\.]+)\\s*TL/);\n  const price = priceMatch ? priceMatch[1] + ' TL' : '';\n  \n  const ratingMatch = line.match(/Rating:\\s*([\\d\\.]+)/i);\n  const rating = ratingMatch ? ratingMatch[1] : '';\n  \n  let name = line\n    .replace(/^\\d+\\.\\s+/, '')\n    .replace(/\\+\\+/g, '')\n    .replace(/\\*\\*/g, '')\n    .replace(/([\\d,\\.]+)\\s*TL/g, '')\n    .replace(/\\(Rating:[^)]*\\)/gi, '')\n    .replace(/:\\s*$/, '')\n    .trim();\n  \n  return {\n    json: {\n      name: name,\n      price: price,\n      rating: rating,\n      date: new Date().toLocaleDateString('tr-TR')\n    }\n  };\n});\n\nreturn products.length > 0 ? products : [{ \n  json: { name: output.substring(0, 200), price: '', rating: '', date: new Date().toLocaleDateString('tr-TR') }\n}];\n"
      },
